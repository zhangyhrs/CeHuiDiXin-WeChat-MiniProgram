<view class="container">
<view class="page-title">EPSG 与坐标系查询</view>
<view class="muted">区分地理坐标与投影坐标，支持经度或当前位置自动判断</view>

<view class="card">
 <view class="module-title">按经度计算</view>
 <input class="input" placeholder="输入经度，例如 108.95756972" type="digit" value="{{lon}}" bindinput="setLon"/>
 <view class="grid2">
  <button class="btn" bindtap="calc">按输入计算</button>
  <button class="ghost" bindtap="locate">使用当前位置</button>
 </view>
 <view class="loc" wx:if="{{currentLon}}">当前定位：{{currentLat}}, {{currentLon}}　精度约 {{locationAccuracy}}</view>
</view>

<view class="card" wx:if="{{result}}">
 <view class="coord-block">
  <view class="coord-title">地理坐标</view>
  <view class="row"><text>CGCS2000</text><text>EPSG:4490</text></view>
  <view class="module-desc">经纬度坐标，单位通常为度。</view>
 </view>

 <view class="coord-block projected">
  <view class="coord-title">投影坐标 · 3°分带</view>
  <view class="row"><text>带号 / 中央经线</text><text>{{result.zone3}} / {{result.cm3}}°</text></view>
  <view class="row"><text>带号坐标系</text><text wx:if="{{result.epsg3Zone}}">EPSG:{{result.epsg3Zone}}</text><text wx:else>-</text></view>
  <view class="row"><text>中央经线坐标系</text><text wx:if="{{result.epsg3CM}}">EPSG:{{result.epsg3CM}}</text><text wx:else>-</text></view>
 </view>

 <view class="coord-block projected">
  <view class="coord-title">投影坐标 · 6°分带</view>
  <view class="row"><text>带号 / 中央经线</text><text>{{result.zone6}} / {{result.cm6}}°</text></view>
  <view class="row"><text>带号坐标系</text><text wx:if="{{result.epsg6Zone}}">EPSG:{{result.epsg6Zone}}</text><text wx:else>-</text></view>
  <view class="row"><text>中央经线坐标系</text><text wx:if="{{result.epsg6CM}}">EPSG:{{result.epsg6CM}}</text><text wx:else>-</text></view>
 </view>
</view>

<view class="section-title">EPSG 速查</view>
<input class="input" placeholder="例如 4490、4524、CGCS2000" bindinput="inputSearch"/>
<view class="card" wx:for="{{filtered}}" wx:key="code" data-code="{{item.code}}" bindtap="copy">
 <view class="kind">{{item.kind}}</view>
 <view class="code">{{item.code}}</view>
 <view class="module-title">{{item.name}}</view>
 <view class="module-desc">{{item.note}} · 点击复制</view>
</view>
</view>