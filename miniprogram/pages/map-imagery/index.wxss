
.sourcebar{display:flex;gap:12rpx;background:#fff;padding:18rpx 20rpx}
.sourcebar text{flex:1;text-align:center;padding:12rpx 8rpx;border-radius:999rpx;background:#F2F4F7;color:#475467;font-size:23rpx}
.sourcebar .active{background:#0B4F8A;color:#fff}
.tilebox{position:relative;width:100%;height:768rpx;overflow:hidden;background:#111}
.tilegrid{display:grid;grid-template-columns:repeat(3,256rpx);grid-template-rows:repeat(3,256rpx);width:768rpx;height:768rpx;margin:0 auto}
.tile{width:256rpx;height:256rpx;display:block}
.cross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:54rpx;color:#fff;text-shadow:0 1px 4px #000;pointer-events:none}
.amapbox{width:100%;min-height:560rpx;background:#F2F4F7;display:flex;align-items:center;justify-content:center}
.amapimg{width:100%}
.empty{color:#98A2B3;padding:80rpx 30rpx}
.toolbar{display:flex;align-items:center;justify-content:center;gap:24rpx;margin:10rpx 0 20rpx}
.toolbar text{font-size:24rpx;color:#667085}
.pan{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-bottom:24rpx}
.pan .up{grid-column:2}.pan .left{grid-column:1}.pan .center{grid-column:2}.pan .right{grid-column:3}.pan .down{grid-column:2}
