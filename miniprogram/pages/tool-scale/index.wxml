<view class="container"><view class="page-title">比例尺计算</view><view class="card"><view class="module-title">比例尺 1 : N</view><input class="input" type="number" value="{{scale}}" bindinput="setScale"/><input class="input" type="digit" placeholder="图上距离（cm）" bindinput="setMap"/><button class="btn" bindtap="mapToGround">计算实地距离</button><input class="input" type="digit" placeholder="实地距离（m）" bindinput="setGround"/><button class="ghost" bindtap="groundToMap">计算图上距离</button></view><view class="card" wx:if="{{result}}"><view class="value">{{result}}</view></view></view>