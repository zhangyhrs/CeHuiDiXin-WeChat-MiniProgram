<view class="container"><view class="page-title">坡度计算</view><view class="card"><input class="input" placeholder="高差 ΔH（m）" type="digit" data-k="dh" bindinput="set"/><input class="input" placeholder="水平距离 D（m）" type="digit" data-k="d" bindinput="set"/><button class="btn" bindtap="calc">计算</button></view><view class="card" wx:if="{{slope}}"><view class="row"><text>坡度</text><text>{{slope}}</text></view><view class="row"><text>坡角</text><text>{{angle}}</text></view></view></view>