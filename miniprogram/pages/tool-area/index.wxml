<view class="container"><view class="page-title">面积换算</view><view class="card"><input class="input" type="digit" placeholder="输入面积数值" bindinput="setValue"/><picker range="{{units}}" bindchange="setUnit"><view class="picker">当前单位：{{unit}}</view></picker><button class="btn" bindtap="calc">换算</button></view><view class="card" wx:if="{{result}}"><view class="row"><text>平方米</text><text>{{result.m2}} ㎡</text></view><view class="row"><text>公顷</text><text>{{result.ha}} ha</text></view><view class="row"><text>亩</text><text>{{result.mu}} 亩</text></view><view class="row"><text>平方公里</text><text>{{result.km2}} km²</text></view></view></view>