<view class="container"><view class="page-title">度分秒转换</view><view class="card"><view class="module-title">十进制度 → 度分秒</view><input class="input" type="digit" placeholder="例如 91.123456" bindinput="setDecimal"/><button class="btn" bindtap="toDms">转换</button></view><view class="card"><view class="module-title">度分秒 → 十进制度</view><view class="triple"><input class="input" type="digit" placeholder="度" bindinput="setD"/><input class="input" type="digit" placeholder="分" bindinput="setM"/><input class="input" type="digit" placeholder="秒" bindinput="setS"/></view><button class="btn" bindtap="toDecimal">转换</button></view><view class="result card" wx:if="{{result}}"><view class="module-title">结果</view><view class="value">{{result}}</view></view></view>