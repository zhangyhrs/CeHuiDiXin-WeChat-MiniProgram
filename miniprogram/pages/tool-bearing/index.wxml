<view class="container"><view class="page-title">方位角计算</view><view class="muted">按平面坐标从点1指向点2计算</view><view class="card"><input class="input" placeholder="X1" type="digit" data-k="x1" bindinput="set"/><input class="input" placeholder="Y1" type="digit" data-k="y1" bindinput="set"/><input class="input" placeholder="X2" type="digit" data-k="x2" bindinput="set"/><input class="input" placeholder="Y2" type="digit" data-k="y2" bindinput="set"/><button class="btn" bindtap="calc">计算方位角</button></view><view class="card" wx:if="{{result}}"><view class="result-value">{{result}}</view></view></view>