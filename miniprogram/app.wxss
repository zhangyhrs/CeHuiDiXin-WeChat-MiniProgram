
page{background:#F4F7FA;color:#1D2939;font-size:28rpx}.container{padding:28rpx}.card{background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 6rpx 24rpx rgba(16,24,40,.05)}.page-title{font-size:38rpx;font-weight:800;color:#0B4F8A}.section-title{font-size:31rpx;font-weight:700;margin:30rpx 0 18rpx}.muted{color:#667085;font-size:24rpx}.tag{display:inline-block;padding:6rpx 14rpx;border-radius:999rpx;background:#E8F3FB;color:#0B6FA4;font-size:22rpx;margin-right:10rpx}.btn{background:#0B4F8A;color:#fff;border-radius:14rpx}.ghost{background:#fff;color:#0B4F8A;border:1rpx solid #D0D5DD;border-radius:14rpx}.empty{text-align:center;color:#98A2B3;padding:100rpx 20rpx}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.module-card{background:#fff;border-radius:18rpx;padding:26rpx;min-height:140rpx}.module-title{font-weight:700;font-size:29rpx;margin-top:12rpx}.module-desc{color:#667085;font-size:22rpx;line-height:1.5;margin-top:10rpx}.badge{display:inline-block;min-width:58rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:16rpx;background:#E8F3FB;color:#0B4F8A;font-weight:800}

.input{background:#F2F4F7;border-radius:12rpx;height:76rpx;padding:0 18rpx;margin:16rpx 0;box-sizing:border-box}.result-value{font-size:36rpx;color:#0B4F8A;font-weight:800;margin-top:16rpx;word-break:break-all}.row{display:flex;justify-content:space-between;gap:24rpx;padding:18rpx 0;border-bottom:1rpx solid #F2F4F7}.row text:last-child{color:#0B4F8A;font-weight:700;text-align:right}
